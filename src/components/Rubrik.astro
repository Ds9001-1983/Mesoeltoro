---
/**
 * Rubrikkopf: römische Ziffer, spanische Rubrik, deutsche Überschrift.
 *
 * Der Griff, der die Seite ordnet. Die spanische Zeile ist kein Zierrat,
 * sondern die Herkunftssprache des Hauses — und weil sie über der deutschen
 * Überschrift steht, verstehen auch Gäste ohne Spanisch sofort, worum es geht.
 *
 * Barrierefreiheit:
 *
 *  · Ziffer und spanische Rubrik sind KEINE Überschrift. Sie stehen in
 *    <p>-Elementen daneben, damit die Überschriftenliste eines Screenreaders
 *    sauber bleibt — dort gehört „Argentinische Steaks“ hin, nicht
 *    „I La Parrilla — El Corazón Argentinische Steaks“.
 *  · Die spanische Zeile bekommt `lang="es"`. Ohne das liest eine deutsche
 *    Stimme „La Parrilla“ als „La Parrilla“ mit deutschem Lautwert (3.1.2).
 *  · Die Ziffer ist zusätzlich `aria-hidden`: Sie ist eine Gliederungshilfe
 *    fürs Auge. Vorgelesen („römisch eins“) trägt sie nichts bei, was die
 *    Überschrift nicht schon sagt.
 *  · Die goldene Haarlinie darüber zeichnet sich beim Scrollen — reines
 *    Dekor, ohne Zustandsbedeutung.
 */

interface Props {
  /** Römische Ziffer, etwa „I“. */
  readonly ziffer: string
  /** Spanische Rubrik, etwa „La Parrilla — El Corazón“. */
  readonly spanisch: string
  /** Die Kennung, unter der die Sektion per aria-labelledby verweist. */
  readonly id: string
  readonly klasse?: string
}

const { ziffer, spanisch, id, klasse } = Astro.props
---

<div class:list={['rubrik', klasse]}>
  <span class="rubrik__linie" aria-hidden="true" data-dekor></span>

  <p class="rubrik__kopf">
    <span class="rubrik__ziffer" aria-hidden="true">{ziffer}</span>
    <span class="rubrik__spanisch" lang="es">{spanisch}</span>
  </p>

  <h2 class="rubrik__titel" id={id}>
    <slot />
  </h2>
</div>

<style>
  .rubrik {
    padding-block-start: var(--raum-2);
  }

  .rubrik__linie {
    display: block;
    block-size: 1px;
    inline-size: 100%;
    background-color: var(--linie);
    transform-origin: left center;
  }

  .rubrik__kopf {
    display: flex;
    align-items: baseline;
    gap: var(--raum-5);
    margin-block-start: var(--raum-5);
    font-family: var(--schrift-mikro);
    font-size: var(--t-eyebrow);
    letter-spacing: var(--sperrung);
    text-transform: uppercase;
    /*
     * Semantisch, nicht wörtlich: Die Rubrik steht auf beiden Flächen.
     * Auf Grund löst --akzent zu Gold auf (7,85:1), auf Kalk zu Ochsenblut
     * (12,37:1). Stünde hier var(--gold), wäre die Zeile auf den hellen
     * Kapiteln mit 2,09:1 praktisch unlesbar.
     */
    color: var(--akzent);
  }

  .rubrik__ziffer {
    flex: none;
    font-variant-numeric: tabular-nums;
  }

  .rubrik__titel {
    margin-block-start: var(--raum-4);
    font-size: clamp(1.9rem, 1.1rem + 3.4vw, 4rem);
    max-inline-size: 20ch;
  }
</style>

<style is:global>
  /*
   * Die Haarlinie zeichnet sich von links, die Überschrift wächst von unten
   * ins Bild — beides scroll-getrieben, beides rein dekorativ.
   *
   * Nur Langformen: `animation` zusammen mit `animation-timeline` wird von
   * den Minifiern zusammengefaltet und damit ungültig. Steht auf der
   * Verbotsliste in CLAUDE.md.
   */
  /*
   * ACHTUNG BEI DEN BEREICHEN — hier lagen zwei Fehler, die zusammen dafür
   * gesorgt haben, dass von diesem Move nichts zu sehen war. Am 29.07.2026
   * gemessen, nachdem der Auftraggeber „es läuft nix" gemeldet hatte.
   *
   * 1. Die Prozente eines `entry`-Bereichs sind Anteile der Höhe des
   *    ANIMIERTEN ELEMENTS, nicht der Fensterhöhe. Die Haarlinie ist 1 px
   *    hoch. `entry 10%` bis `entry 70%` waren damit **0,6 px Scrollweg** —
   *    der Fortschritt sprang zwischen zwei Scrollpositionen von 0 auf 100 %.
   *    Die Animation lief also tadellos und war trotzdem unsichtbar.
   *
   * 2. Die Überschrift war fertig aufgezogen, bevor sie den unteren
   *    Bildschirmrand verlassen hatte: Start bei 95,6–98,8 % Fensterhöhe,
   *    Ende bei 82–94 %. Vorbei, ehe die Zeile im Lesebereich ankam.
   *
   * Beides ist behoben, indem das Ende in `cover` angegeben wird. Der
   * cover-Bereich ist Fensterhöhe + Elementhöhe lang, damit geht die
   * Fenstergröße in die Rechnung ein und die Elementhöhe verliert ihren
   * Alleineinfluss. Bei 1440 × 900 sind das rund 270 px für die Linie und
   * 378 px für die Überschrift — statt 0,6 px.
   *
   * `entry 0%` und `cover 0%` bezeichnen denselben Punkt: den Moment, in dem
   * die Oberkante den unteren Fensterrand berührt.
   */
  @supports (animation-timeline: view()) {
    :root[data-motion='full'] .rubrik__linie {
      /*
       * Der Name ist komponenteneindeutig, und das ist keine Kosmetik.
       *
       * Er hieß bis zum 29.07.2026 `linie-zeichnen` — genau wie der Keyframe
       * in Gerichtszeile.astro. `@keyframes` in einem `is:global`-Block
       * gelten für das ganze Dokument; bei Namensgleichheit gewinnt die
       * zuletzt geparste Definition. Die Fassung der Gerichtszeile hat keinen
       * `from`-Schritt, weil sie ihren Startwert als Basisdeklaration setzt.
       * Die Haarlinie hat keine solche Basis — ihr Startwert wurde damit der
       * berechnete Wert, also `scaleX(1)`. Anfang gleich Ende: Die Animation
       * lief und veränderte nichts.
       *
       * Nachgewiesen über getAnimations()[0].effect.getKeyframes(), das
       * `0: none | 1: scaleX(1)` lieferte.
       */
      animation-name: rubrik-linie-zeichnen;
      animation-duration: 1s;
      animation-timing-function: cubic-bezier(0.22, 0.61, 0.36, 1);
      animation-fill-mode: both;
      animation-timeline: view();
      animation-range-start: entry 0%;
      animation-range-end: cover 30%;
    }

    :root[data-motion='full'] .rubrik__titel {
      animation-name: titel-aufziehen;
      animation-duration: 1s;
      animation-timing-function: cubic-bezier(0.22, 0.61, 0.36, 1);
      animation-fill-mode: both;
      animation-timeline: view();
      animation-range-start: entry 0%;
      animation-range-end: cover 35%;
    }
  }

  @keyframes rubrik-linie-zeichnen {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /*
   * clip-path statt opacity: Die Überschrift ist damit im Ausgangszustand
   * beschnitten, aber vorhanden — sie steht im Textbaum, ist auffindbar und
   * bleibt bei abgeschalteter Bewegung vollständig sichtbar. Ein Reveal über
   * `opacity: 0` würde Inhalt dauerhaft verschwinden lassen, sobald die
   * Animation nicht läuft.
   */
  @keyframes titel-aufziehen {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
</style>
