---
/**
 * Startseite.
 *
 * Gliederung nach dem Vorbild der SUPERBRAND-Vorschau: römische Ziffern,
 * spanische Rubriken, dunkle Grundfläche durchgehend. Sechs nummerierte
 * Kapitel zwischen Hero und Fuß.
 *
 * Der Hero ist die einzige Stelle, an der die Vorschau eine Projektregel
 * bricht — dort liegt die Headline auf dem scroll-skalierten Bild. Hier
 * steht das Bild still, und die Schrift sitzt in dem Bereich, in dem die
 * Verläufe die Fläche auf reines --grund ausgelaufen haben. Ein Test misst
 * die tatsächliche Hintergrundfarbe hinter jedem Textknoten des Heros.
 */
import Bild from '../components/Bild.astro'
import Gaestestimme from '../components/Gaestestimme.astro'
import GlutKapitel from '../components/GlutKapitel.astro'
import JsonLd from '../components/JsonLd.astro'
import Gerichtszeile from '../components/Gerichtszeile.astro'
import Laufband from '../components/Laufband.astro'
import Rubrik from '../components/Rubrik.astro'
import Statusband from '../components/Statusband.astro'
import Basis from '../layouts/Basis.astro'
import historie from '../../content/historie.json'
import stimmen from '../../content/stimmen.json'
import { restaurant } from '../lib/daten.ts'
import { KATEGORIEN, preiszeile } from '../lib/karte.ts'

const steaks = KATEGORIEN.find((kategorie) => kategorie.id === 'steaks')

// Fünf Zeilen als Auszug — die Karte selbst hat eine eigene Route.
const auszug = KATEGORIEN.flatMap((kategorie) => kategorie.gerichte).filter((gericht) =>
  ['gambas-al-ajillo', 'carpaccio-rinderfilet', 'kalbskotelett', 'seezunge', 'crema-catalana'].includes(
    gericht.id,
  ),
)

const BEGRIFFE = [
  'La Morocha',
  'Parrilla',
  'Bodega',
  'Asado',
  'Estancia',
  'Aberdeen Angus',
  'Pampa',
]
---

<Basis
  titel="Spanisches Restaurant & Steakhouse"
  beschreibung="Seit 1975 argentinischer Grill und spanische Küche in Waldbröl. Mittwoch bis Sonntag, mittags und abends geöffnet. Reservierung unter 02291 4347."
>
  <JsonLd slot="kopf" />

  {/* --- Hero ------------------------------------------------------------- */}
  <section class="hero" aria-labelledby="hero-titel">
    <div class="hero__bild">
      <Bild schluessel="glut-grill" breite={1600} hoehe={1067} vorrang sizes="100vw" />
    </div>

    {/*
      Vier gestapelte Verläufe, wie in der Vorschau. Der unterste bringt die
      Fläche unter der Schrift auf reines --grund — dort steht die Headline
      also auf einfarbigem Grund, nicht auf Bildinhalt.
    */}
    <div class="hero__grade" aria-hidden="true" data-dekor></div>
    <div class="hero__vignette" aria-hidden="true" data-dekor></div>

    <div class="hero__inhalt">
      {/*
        Die feste Fläche hängt am TEXTBLOCK, nicht an einem Prozentsatz der
        Hero-Höhe.

        Vorher war sie ein Verlauf über 52 % der Sektion. Das ging bei
        1440 × 900 gerade auf und war bei 1440 × 1200 doppelt so hoch wie
        nötig — auf hohen Bildschirmen blieb vom Bild fast nichts. Jetzt ist
        sie exakt so hoch wie der Text plus ein fester Übergang darüber,
        unabhängig von der Fenstergröße.
      */}
      <div class="hero__flaeche">
        <div class="hero__unten">
        {/*
          Die Kickerzeile stand bis zum 29.07.2026 oben über dem Bild und
          brauchte dafür einen eigenen dunklen Fleck. Der kostete genau die
          Bildstelle, an der das Steak liegt. Jetzt steht sie unmittelbar über
          der Überschrift auf voller Fläche — die klassische Position einer
          Dachzeile, und der obere Bildbereich bleibt unangetastet.
        */}
        <p class="hero__kicker">
          <span lang="es">Mesón el Toro — Parrilla Argentina</span> · Waldbröl · <span lang="es"
            >Desde</span
          > {restaurant.zahlen.gegruendet}
        </p>

        <h1 id="hero-titel" class="hero__titel">
          Feuer, Fleisch<br />&amp; <span class="hero__gold">spanischer</span><br />Wein.
        </h1>

        {/*
          Der Vorspann stand bis zum 29.07.2026 hier und sagte fast dasselbe
          wie der große Satz eine Sektion tiefer. Zwei Gründe, ihn zu
          streichen: Er war eine Dopplung, und er machte den Textblock so
          hoch, dass für das Bild nur noch ein Sechstel des Heros übrig blieb.
          Die Aussage steht vollständig in der Positionierung darunter.
        */}
        <div class="wege">
          <a class="ruf-block" href={`tel:${restaurant.telefon_e164}`} data-ziel>
            <span class="ruf-block__wort">Reservierung</span>
            <span class="ruf-block__nummer zahlen">{restaurant.telefon_anzeige}</span>
          </a>
          <a class="weiter" href="/speisekarte/">Speisekarte ansehen</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* --- Positionierung ---------------------------------------------------- */}
  <section class="haltung" aria-labelledby="haltung-titel">
    <h2 id="haltung-titel" class="vh">Was dieses Haus ausmacht</h2>
    <p class="huelle haltung__satz">
      Tradition aus dem <span class="hervor">Bergischen Land</span>, argentinisches Premiumfleisch
      von der <span class="spanisch" lang="es">Estancia</span>, spanische Feinkost und ein eigener
      Weinkeller — an einem Tisch vereint.
    </p>
  </section>

  <Laufband begriffe={BEGRIFFE} />

  {/* --- I · La Parrilla ---------------------------------------------------- */}
  <section class="kapitel" aria-labelledby="parrilla-titel">
    <div class="huelle kapitel__raster">
      <div class="kapitel__text">
        <Rubrik ziffer="I" spanisch="La Parrilla — El Corazón" id="parrilla-titel">
          Argentinische Steaks »La Morocha«
        </Rubrik>

        <p class="kapitel__vorspann">
          Aberdeen Angus von der <span class="spanisch" lang="es">Pampa</span>, über offener Glut
          gegrillt. Zwei Schnitte, zwei Größen, kein Beiwerk — was zählt, ist der Punkt, an dem das
          Fleisch vom Rost kommt.
        </p>

        {
          steaks && (
            <dl class="preise">
              {steaks.gerichte.map((gericht) => (
                <div class="preise__zeile">
                  <dt>{gericht.name}</dt>
                  <dd class="preis">{preiszeile(gericht)}</dd>
                </div>
              ))}
            </dl>
          )
        }

        <p class="kapitel__weiter">
          <a class="weiter" href="/speisekarte/#steaks">Alle Gerichte vom Grill</a>
        </p>
      </div>

      <div class="kapitel__bild kapitel__bild--hoch">
        <Bild
          schluessel="steak-grillmuster"
          breite={1200}
          hoehe={1600}
          sizes="(min-width: 62rem) 38vw, 100vw"
        />
      </div>
    </div>
  </section>

  {/* --- II · La Carta ------------------------------------------------------
      Erstes helles Kapitel. Eine Speisekarte ist gedruckt — auf Papier, nicht
      auf Nacht. Der Wechsel ist deshalb keine reine Helligkeitsfrage, er
      erklärt sich aus dem Inhalt. Hier kommt außerdem das Markenrot zurück:
      Auf Kalk trägt es 12,37:1, auf dem dunklen Grund nur 1,32:1.        */}
  <section class="kapitel kapitel--hell" data-flaeche="hell" aria-labelledby="carta-titel">
    <div class="huelle kapitel__raster kapitel__raster--gedreht">
      <div class="kapitel__bild">
        <Bild
          schluessel="fisch-teller"
          breite={1200}
          hoehe={1200}
          sizes="(min-width: 62rem) 38vw, 100vw"
        />
      </div>

      <div class="kapitel__text">
        <Rubrik ziffer="II" spanisch="La Carta" id="carta-titel">Aus unserer Speisekarte</Rubrik>

        <p class="kapitel__vorspann">
          Gambas al Ajillo, Seezunge, Crema Catalana. Die spanische Seite des Hauses kommt aus der
          Gründungszeit und ist geblieben, weil sie zum Grill passt.
        </p>

        <ul class="auszug__liste liste-schlicht">
          {auszug.map((gericht) => <Gerichtszeile gericht={gericht} />)}
        </ul>

        <p class="kapitel__weiter">
          <a class="weiter" href="/speisekarte/">Zur vollständigen Speisekarte</a>
        </p>
      </div>
    </div>
  </section>

  {/* --- III · Sobre la brasa ----------------------------------------------- */}
  <GlutKapitel />

  {/* --- IV · La Filosofía --------------------------------------------------- */}
  <section class="kapitel" aria-labelledby="filosofia-titel">
    <div class="huelle">
      <Rubrik ziffer="IV" spanisch="La Filosofía" id="filosofia-titel">
        Qualität, Herkunft &amp; Historie
      </Rubrik>

      <div class="filosofia__raster">
        <div>
          <p class="kapitel__vorspann">
            Ein Haus überlebt fünfzig Jahre nicht durch Ankündigungen, sondern dadurch, dass die
            Gäste wiederkommen.
          </p>

          <ol class="historie__jahre liste-schlicht">
            {
              historie.stationen.slice(0, 3).map((station) => (
                <li class="historie__jahr">
                  <p class="historie__zahl zahlen">{station.jahr}</p>
                  <p class="historie__text mikro leise">{station.titel}</p>
                </li>
              ))
            }
          </ol>

          <p class="kapitel__weiter">
            <a class="weiter" href="/philosophie/">Die ganze Geschichte</a>
          </p>
        </div>

        <div class="kapitel__bild">
          <Bild
            schluessel="schild-haus"
            breite={1200}
            hoehe={1200}
            sizes="(min-width: 62rem) 42vw, 100vw"
          />
        </div>
      </div>
    </div>
  </section>

  {/* --- Bildband ------------------------------------------------------------
      Der einzige Ort der Seite, an dem ein Bild über die Kante läuft. Nach
      vier Kapiteln über Essen ein Atemzug — und inhaltlich die Überleitung
      zu den Gästen.

      Vorlage nativ 3000 px breit, also ohne Hochskalieren retinatauglich.  */}
  <div class="bildband">
    <Bild schluessel="gastraum-band" breite={2400} hoehe={1198} sizes="100vw" />
  </div>

  {/* --- V · Los Huéspedes ---------------------------------------------------
      Vier Stimmen aus dem öffentlichen Google-Profil. Jede trägt den
      Prüfhinweis nach § 5b Abs. 3 UWG — Gaestestimme.astro rendert ihn
      zwingend mit, es gibt keinen Schalter dagegen.                        */}
  <section class="kapitel kapitel--hell" data-flaeche="hell" aria-labelledby="huespedes-titel">
    <div class="huelle">
      <Rubrik ziffer="V" spanisch="Los Huéspedes" id="huespedes-titel">
        Das sagen unsere Gäste
      </Rubrik>

      <div class="stimmen__raster">
        {stimmen.stimmen.map((zitat) => <Gaestestimme zitat={zitat} />)}
      </div>
    </div>
  </section>

  {/* --- VI · La Reserva ------------------------------------------------------
      Bordeaux war seit dem Umbau definiert und stand nirgends. Als Schluss
      der Seite trägt die Vollfläche genau das, wofür sie gedacht war: einen
      Block, der aufhört zu erzählen und stattdessen die Nummer hinstellt.
      Auf Bordeaux trägt Elfenbein (9,20:1), NICHT Gold (4,13:1) — der
      Umschalter in tokens.css setzt das um, die Komponenten merken nichts. */}
  <section
    class="kapitel kapitel--schluss"
    data-flaeche="bordeaux"
    aria-labelledby="reserva-titel"
  >
    <div class="huelle kapitel__raster">
      <div class="kapitel__text">
        <Rubrik ziffer="VI" spanisch="La Reserva" id="reserva-titel">
          Kontakt &amp; Reservierung
        </Rubrik>

        <p class="kapitel__vorspann">
          Mittwoch bis Sonntag, zweimal am Tag. Reservierungen nehmen wir am Telefon entgegen —
          wenn Sie lieber schreiben, bestätigen wir Ihren Tisch schriftlich.
        </p>

        <Statusband mitKonfiguration klasse="kapitel__status" />

        <div class="wege">
          <a class="ruf-block" href={`tel:${restaurant.telefon_e164}`} data-ziel>
            <span class="ruf-block__wort">Reservierung</span>
            <span class="ruf-block__nummer zahlen">{restaurant.telefon_anzeige}</span>
          </a>
          <a class="weiter" href={`mailto:${restaurant.email}`} data-ziel>{restaurant.email}</a>
        </div>

        <address class="reserva__adresse">
          {restaurant.adresse.strasse}<br />
          {restaurant.adresse.plz} {restaurant.adresse.ort}
        </address>
        <p class="mikro leise reserva__parken">{restaurant.parken.hinweis}</p>
        <p class="kapitel__weiter">
          <a class="weiter" href="/kontakt/">Anfahrt und Öffnungszeiten</a>
        </p>
      </div>

      <div class="kapitel__bild kapitel__bild--hoch">
        <Bild
          schluessel="tafel-gedeckt"
          breite={1200}
          hoehe={1600}
          sizes="(min-width: 62rem) 38vw, 100vw"
        />
      </div>
    </div>
  </section>
</Basis>

<style>
  /* --- Hero ---------------------------------------------------------------- */
  /*
   * 100svh statt 92svh, und der Textsockel bekommt weniger Innenabstand.
   *
   * Grund ist eine Messung vom 29.07.2026: Vom 828 px hohen Hero trug der
   * Textblock 674 px. Fürs Bild blieben rund 150 px — ein Streifen, kein
   * Aufmacher. Die Überschrift läuft über drei Zeilen zu 84 px, daran ist
   * nichts zu kürzen; also wächst der Hero und der Sockel wird knapper.
   */
  .hero {
    position: relative;
    isolation: isolate;
    min-block-size: 100svh;
    display: flex;
    overflow: hidden;
  }

  .hero__grade,
  .hero__vignette {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /*
   * Der Bildkasten reicht NICHT über den ganzen Hero, sondern nur über den
   * Bereich, der tatsächlich zu sehen ist.
   *
   * Vorher lag er über der vollen Höhe. Weil die untere Hälfte von der festen
   * Textfläche verdeckt wird, bildete `object-fit: cover` die Vorlage auf
   * einen Kasten ab, dessen sichtbarer Teil nur das obere Drittel war — und
   * dort liegt auf dieser Aufnahme das UNSCHARFE hintere Steak. Kein
   * `object-position`-Wert konnte das erreichen, weil der Überstand nur
   * 206 px betrug. Am 29.07.2026 zweimal danebengegriffen, bis der Kasten
   * selbst das Problem war.
   */
  .hero__bild {
    position: absolute;
    inset: 0 0 auto 0;
    block-size: 72%;
    overflow: hidden;
    z-index: 0;
  }

  /*
   * Das Bild hängt DIREKT am Kasten, nicht über eine Prozentkette.
   *
   * `block-size: 100%` auf dem <picture> und noch einmal auf dem <img> löste
   * sich nicht auf — das img blieb bei seiner Eigenhöhe von 1080 px, und
   * `object-fit: cover` hatte damit gar nichts zu beschneiden. Sichtbar war
   * einfach der obere Rand der Vorlage, egal welche `object-position` dort
   * stand. Am 29.07.2026 erst durch Messen der berechneten Werte gefunden;
   * am Ergebnis war es nicht zu unterscheiden.
   */
  .hero__bild :global(.bild),
  .hero__bild :global(.bild img),
  .hero__bild :global(.platzhalter) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    /* Auf dem Foto liegt hinten ein unscharfes Steak, vorn das scharfe.
       72 % holt den scharfen Vordergrund ins Band. */
    object-position: 50% 72%;
  }

  /*
   * Warme Gradierung. Deutlich zurückgenommen gegenüber der ersten Fassung.
   *
   * Vorher endete der Verlauf bei #47240e — das multipliziert mit
   * 0,28 / 0,14 / 0,05. Zusammen mit Vignette und Sockel blieb vom Motiv fast
   * nichts übrig; der Auftraggeber konnte das Steak nicht mehr erkennen.
   * Jetzt endet er bei #7d4520 (0,49 / 0,27 / 0,13). Die Wärme bleibt, das
   * Bild kommt zurück.
   *
   * Wie weit sich das aufhellen lässt, entscheidet nicht das Auge, sondern
   * tests/verhalten/hero-grund.spec.ts: Er misst den real gerenderten
   * Kontrast hinter jeder Textzeile. So hell wie möglich, so dunkel wie nötig.
   */
  .hero__grade {
    mix-blend-mode: multiply;
    background: linear-gradient(155deg, #fbe6cc 0%, #d79a68 46%, #9c6136 100%);
  }

  .hero__vignette {
    background: radial-gradient(
      ellipse 110% 100% at 58% 34%,
      transparent 52%,
      color-mix(in srgb, var(--grund) 26%, transparent) 82%,
      color-mix(in srgb, var(--grund) 70%, transparent) 100%
    );
  }

  .hero__inhalt {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    inline-size: 100%;
  }

  /*
   * Zwei Hintergrundlagen, beide ohne Wiederholung:
   *   oben  — ein Übergang von durchsichtig auf Grund, genau --fade hoch
   *   unten — volle Fläche über den ganzen Rest
   *
   * Damit ist der feste Bereich immer exakt so hoch wie der Text, egal wie
   * hoch das Fenster ist. Genau das misst hero-grund.spec.ts nach.
   */
  .hero__flaeche {
    --fade: clamp(3rem, 10svh, 6rem);

    padding-block: var(--fade) var(--raum-7);
    background-image:
      linear-gradient(0deg, var(--grund) 0%, transparent 100%),
      linear-gradient(var(--grund), var(--grund));
    background-size:
      100% var(--fade),
      100% calc(100% - var(--fade));
    background-position:
      top,
      bottom;
    background-repeat: no-repeat, no-repeat;
  }

  .hero__unten {
    inline-size: min(100% - 2 * var(--rahmen), var(--breite-max));
    margin-inline: auto;
  }

  /* Auf schmalen Schirmen bricht die Überschrift auf mehr Zeilen um und die
     Schaltflächen stapeln sich — der Textblock reicht dann weiter nach oben
     als der Übergang. Kürzerer Übergang, damit die feste Fläche früher
     beginnt. Bei 320 px bleibt vom Bild ohnehin nur ein schmales Band. */
  @media (max-width: 47.99rem) {
    .hero__flaeche {
      --fade: 2.5rem;
    }
  }

  .hero__kicker {
    margin-block-end: var(--raum-5);
    font-family: var(--schrift-mikro);
    font-size: var(--t-eyebrow);
    letter-spacing: var(--sperrung);
    text-transform: uppercase;
    color: var(--gold);
  }

  .hero__titel {
    font-size: var(--t-mega);
    /* Keine Breitenbegrenzung: Die Umbrüche stehen als <br> im Markup, die
       Zeilen sollen genau dort brechen und nirgendwo sonst. */
  }

  .hero__gold {
    color: var(--gold);
  }

  .hero__lead {
    margin-block-start: var(--raum-6);
    max-inline-size: 46ch;
    font-size: var(--t-lead);
    line-height: 1.7;
  }

  .wege {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--raum-4) var(--raum-7);
    margin-block-start: var(--raum-7);
  }

  /* --- Reservierungsblock -------------------------------------------------- */
  .ruf-block {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    min-block-size: var(--ziel-min);
    padding: var(--raum-3) var(--raum-6);
    /*
     * Semantisch, weil dieser Block auf drei Flächen steht: im Hero auf
     * Grund, in Kapitel VI auf Bordeaux. Mit var(--gold) stünde das Wort
     * „Reservierung“ dort bei 4,13:1 — für Versalien in 12–14 px zu wenig.
     * Über --akzent wird daraus Elfenbein mit 9,20:1.
     */
    border: 1px solid var(--akzent);
    text-decoration: none;
    transition:
      background-color var(--dauer-mittel) var(--ease),
      color var(--dauer-mittel) var(--ease);
  }

  .ruf-block__wort {
    display: block;
    font-family: var(--schrift-mikro);
    font-size: var(--t-eyebrow);
    letter-spacing: var(--sperrung);
    text-transform: uppercase;
    color: var(--akzent);
  }

  .ruf-block__nummer {
    display: block;
    font-family: var(--schrift-display);
    font-size: 1.35rem;
    line-height: 1.15;
    color: var(--text);
  }

  /*
   * Gefüllter Zustand. Die Füllung ist der Akzent der jeweiligen Fläche,
   * die Schrift darauf die Fläche selbst — das Verhältnis ist damit
   * automatisch dasselbe wie ungefüllt, nur umgedreht:
   *
   *   auf Grund      Grund auf Gold          7,85:1
   *   auf Kalk       Kalk auf Ochsenblut    12,37:1
   *   auf Bordeaux   Bordeaux auf Elfenbein  9,20:1
   */
  .ruf-block:hover,
  .ruf-block:focus-visible {
    background-color: var(--akzent);
  }

  .ruf-block:hover .ruf-block__wort,
  .ruf-block:hover .ruf-block__nummer,
  .ruf-block:focus-visible .ruf-block__wort,
  .ruf-block:focus-visible .ruf-block__nummer {
    color: var(--flaeche);
  }

  .weiter {
    font-style: italic;
    font-size: var(--t-lead);
  }

  /* --- Positionierung ------------------------------------------------------ */
  .haltung {
    padding-block: var(--raum-9);
    border-block-end: 1px solid var(--linie);
  }

  .haltung__satz {
    font-size: clamp(1.4rem, 0.9rem + 2.2vw, 2.4rem);
    line-height: 1.4;
    max-inline-size: 34ch;
  }

  /* --- Kapitel ------------------------------------------------------------- */
  .kapitel {
    padding-block: var(--raum-9);
  }

  /*
   * Die Flächenkapitel bekommen mehr Luft als die dunklen — sonst sieht der
   * Farbwechsel aus wie ein versehentlicher Streifen statt wie ein eigener
   * Bogen. Der Schnitt zwischen den Flächen bleibt hart: kein Verlauf, keine
   * abgerundete Ecke. Ein Kapitelwechsel ist eine Kante.
   */
  .kapitel--hell,
  .kapitel--schluss {
    padding-block: calc(var(--raum-9) * 1.25);
  }

  .kapitel--schluss {
    border-block-start: none;
  }

  .kapitel__raster {
    display: grid;
    gap: var(--raum-8);
  }

  /* Rasterzellen haben von sich aus `min-width: auto` und schrumpfen damit
     nicht unter ihren Mindestinhalt. Eine einzige lange Gerichtszeile hat so
     am 29.07.2026 die ganze Seite auf 360px aufgezogen — bei 320px gemessen
     ist das ein Reflow-Verstoß (1.4.10). Deshalb überall ausdrücklich 0. */
  .kapitel__raster > *,
  .filosofia__raster > * {
    min-inline-size: 0;
  }

  /*
   * Bildspalte von 0,62fr auf 0,92fr.
   *
   * Bei 1440 px war das Bild in Kapitel I 465 × 620 px groß — 5 % der
   * Fensterfläche. Der Rest war Schrift auf Schwarz. Jetzt trägt das Bild
   * knapp die Hälfte der Zeile und rund die doppelte Fläche. Die Vorlagen
